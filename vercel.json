{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.mjs": {
      "includeFiles": [
        "src/ui/web/**",
        "src/catalog/runtime-master-packages/**"
      ],
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "/api/index.mjs?__path=:path*"
    }
  ]
}
