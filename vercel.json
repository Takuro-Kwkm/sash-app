{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "src/**",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index.mjs?__path=/"
    },
    {
      "source": "/:path*",
      "destination": "/api/index.mjs?__path=:path*"
    }
  ]
}
