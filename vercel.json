{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:deployment",
  "outputDirectory": "artifacts/deployment-static",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "{src/**,contracts/production/released-runtime-packages.v1.json}",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index.mjs?__path=/"
    },
    {
      "source": "/:path*",
      "destination": "/api/index.mjs?__path=:path*"
    }
  ],
  "git": {
    "deploymentEnabled": false
  }
}
