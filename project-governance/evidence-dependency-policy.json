{
  "schema_version": "1.0.0",
  "policy": {
    "exact_head_change_alone_invalidates_all_proofs": false,
    "current_head_binding_required_for_cross_head_reuse": true,
    "fail_closed_when_impact_cannot_be_proven": true,
    "runtime_snapshot_must_match": true,
    "artifact_hash_must_match": true
