        "src/catalog/runtime-master/uchirimo-tabular-v1-adapter.mjs",
        "src/catalog/runtime-master/runtime-app-bridge.mjs",
        "src/catalog/runtime-master/canonical-workbook-reference-v1-adapter.mjs",
        "src/catalog/runtime-master/canonical-workbook-reference-v1-behavior-normalizer.mjs",
        "src/catalog/runtime-master/canonical-runtime-manifest-loader.mjs",
        "src/catalog/runtime-master/runtime-master-registry.mjs",
        "src/catalog/runtime-master/app-runtime-integration-registry.mjs",
        "scripts/uchirimo-full-selector-proof.mjs",
        "project-governance/runtime-snapshot.json",
        "package.json",
        "package-lock.json"
      ]
    },
    "NONTW_EXACT": {
      "proof_model_version": "RUNTIME_UI_SYMBOLIC_FULL_COVERAGE_V1",
