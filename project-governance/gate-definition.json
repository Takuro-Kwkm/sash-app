{
  "schema_version": "1.0.0",
  "gate_order": [
    "CANONICAL_RUNTIME_GATE",
    "RUNTIME_ADAPTER_GATE",
    "WINDOW_FLOW_BASELINE_GATE",
    "CANONICAL_SLOT_SCHEMA_GATE",
    "FLOW_SCHEMA_UNMAPPED_FIELD_GATE",
    "SINGLE_FLOW_ENGINE_GATE",
    "SERIES_OVERRIDE_ELIMINATION_GATE",
    "HUMAN_FLOW_REVIEW_GATE",
    "FULL_FLOW_SIGNATURE_COVERAGE_GATE",
    "FLOW_TRANSITION_GATE",
    "FULL_WINDOW_COVERAGE_GATE",
    "CUSTOM_SIZE_COVERAGE_GATE",
    "DEPENDENCY_GATE",
    "UI_FLOW_GATE",
    "AUTOMATED_TEST_GATE",
    "FULL_BROWSER_FLOW_QA_GATE",
    "FULL_BROWSER_QA_GATE",
    "REGRESSION_GATE",
    "REPOSITORY_GATE",
    "GLOBAL_WINDOW_SELECTION_FLOW_GATE",
    "APP_INTEGRATION_READY"
  ],
  "gates": {
    "CANONICAL_RUNTIME_GATE": { "type": "automatic", "requires_exact_head_evidence": true },
    "RUNTIME_ADAPTER_GATE": { "type": "automatic", "requires_exact_head_evidence": true },
    "WINDOW_FLOW_BASELINE_GATE": { "type": "automatic", "requires_exact_head_evidence": true },
    "CANONICAL_SLOT_SCHEMA_GATE": { "type": "automatic", "requires_exact_head_evidence": true },
    "FLOW_SCHEMA_UNMAPPED_FIELD_GATE": { "type": "automatic", "requires_exact_head_evidence": true },
    "SINGLE_FLOW_ENGINE_GATE": { "type": "automatic", "requires_exact_head_evidence": true },
    "SERIES_OVERRIDE_ELIMINATION_GATE": { "type": "automatic", "requires_exact_head_evidence": true },
    "HUMAN_FLOW_REVIEW_GATE": {
      "type": "human",
      "requires": ["reviewed_exact_head", "review_artifact_identity", "human_approval_reference"],
      "reopen_paths": [
        "src/catalog/runtime-master/**",
        "src/catalog/**",
        "src/ui/web/**",
        "scripts/global-window-flow-*.mjs",
        "project-governance/gate-definition.json"
      ]
    },
    "FULL_FLOW_SIGNATURE_COVERAGE_GATE": { "type": "automatic", "requires_exact_head_evidence": true },
    "FLOW_TRANSITION_GATE": { "type": "automatic", "requires_exact_head_evidence": true },
    "FULL_WINDOW_COVERAGE_GATE": { "type": "automatic", "requires_exact_head_evidence": true },
    "CUSTOM_SIZE_COVERAGE_GATE": { "type": "automatic", "requires_exact_head_evidence": true },
    "DEPENDENCY_GATE": { "type": "automatic", "requires_exact_head_evidence": true },
    "UI_FLOW_GATE": { "type": "automatic", "requires_exact_head_evidence": true },
    "AUTOMATED_TEST_GATE": { "type": "automatic", "requires_exact_head_evidence": true },
    "FULL_BROWSER_FLOW_QA_GATE": { "type": "automatic", "requires_exact_head_evidence": true },
    "FULL_BROWSER_QA_GATE": { "type": "automatic", "requires_exact_head_evidence": true },
    "REGRESSION_GATE": { "type": "automatic", "requires_exact_head_evidence": true },
    "REPOSITORY_GATE": { "type": "automatic", "requires_exact_head_evidence": true },
    "GLOBAL_WINDOW_SELECTION_FLOW_GATE": { "type": "composite" },
    "APP_INTEGRATION_READY": { "type": "composite" }
  },
  "release_requirements": {
    "required_pass_gates": [
      "HUMAN_FLOW_REVIEW_GATE",
      "GLOBAL_WINDOW_SELECTION_FLOW_GATE",
      "FULL_WINDOW_COVERAGE_GATE",
      "CUSTOM_SIZE_COVERAGE_GATE",
      "FULL_BROWSER_FLOW_QA_GATE",
      "FULL_BROWSER_QA_GATE",
      "APP_INTEGRATION_READY"
    ],
    "unverified_qa_case_count_must_equal": 0,
    "required_release_input": [
      "reviewed_exact_head",
      "review_artifact_identity",
      "human_approval_reference"
    ]
  }
}
