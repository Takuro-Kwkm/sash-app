  "measurement_contract": {
    "required_site_measurements": [
      "opening_w_top",
      "opening_w_middle",
      "opening_w_bottom",
      "opening_h_left",
      "opening_h_middle",
      "opening_h_right",
      "diagonal_1",
      "diagonal_2"
    ],
    "rules": [
      {
        "rule_id": "MEAS-UCH-001",
        "target": "size_w",
        "expression": "MIN(opening_w_top,opening_w_middle,opening_w_bottom)",
        "result_requirement": "AUTO_CALCULATED"
      },
      {
        "rule_id": "MEAS-UCH-002",
        "target": "size_h",
        "expression": "MIN(opening_h_left,opening_h_middle,opening_h_right)",
        "result_requirement": "AUTO_CALCULATED"
      },
      {
        "rule_id": "MEAS-UCH-003",
        "target": "squareness_w",
        "expression": "MAX(W points)-MIN(W points)<=3",
        "result_requirement": "REQUIRED_PASS"
      },
      {
        "rule_id": "MEAS-UCH-004",
        "target": "squareness_h",
        "expression": "MAX(H points)-MIN(H points)<=3",
        "result_requirement": "REQUIRED_PASS"
      },
      {
        "rule_id": "MEAS-UCH-005",
        "target": "diagonal",
        "expression": "ABS(diagonal_1-diagonal_2)<=3",
        "result_requirement": "REQUIRED_PASS"
      }
    ]
  },
